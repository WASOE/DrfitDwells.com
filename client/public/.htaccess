RewriteEngine On

# Canonical host: HTTP → HTTPS, www → apex. Preserve path and query (QSA).
# Cloudflare may terminate TLS; honour X-Forwarded-Proto as well as HTTPS.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^ https://driftdwells.com%{REQUEST_URI} [R=301,L,QSA]

RewriteCond %{HTTP_HOST} ^www\.driftdwells\.com$ [NC]
RewriteRule ^ https://driftdwells.com%{REQUEST_URI} [R=301,L,QSA]

# Avoid duplicate homepage HTML at /index.html.
# Match the original request only. An internal SPA rewrite also targets
# /index.html and must not be redirected back to /.
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html[\s?]
RewriteRule ^index\.html$ / [R=301,L,QSA]

# Keep app shell + service worker revalidation strict to avoid stale bundles.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|png|jpg|jpeg|webp|avif|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "^(index\.html|sw\.js)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

# Canonicalize legacy login path before SPA fallback.
RewriteRule ^admin/login/?$ /login [R=302,L]

# Preserve the established off-grid cabin URL as the sole indexable destination.
RewriteRule ^off-grid-stays-bulgaria/?$ /off-grid-cabins-bulgaria/ [R=301,L,QSA]
RewriteRule ^bg/off-grid-stays-bulgaria/?$ /bg/off-grid-cabins-bulgaria/ [R=301,L,QSA]

# Legacy cabin Mongo ID detail URLs → public /stays/:slug (301 for SEO, crawlers, shared links).
# Checkout confirm URLs are intentionally excluded.
RewriteRule ^cabin/69b2ff933a7fff6621e785cc/?$ /stays/the-cabin [R=301,L,QSA]
RewriteRule ^cabin/69b2ff947f141a71ffa7c492/?$ /stays/lux-cabin [R=301,L,QSA]
RewriteRule ^bg/cabin/69b2ff933a7fff6621e785cc/?$ /bg/stays/the-cabin [R=301,L,QSA]
RewriteRule ^bg/cabin/69b2ff947f141a71ffa7c492/?$ /bg/stays/lux-cabin [R=301,L,QSA]

# SPA guide roots overlap with real asset directories.
# Route only the directory root to React; files inside remain static.
RewriteRule ^guides/the-valley/?$ /index.html [L]
RewriteRule ^guides/the-cabin/?$ /index.html [L]

# Do not route API calls to the React app
RewriteCond %{REQUEST_URI} !^/api/ [NC]

# Serve real files and folders normally
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Only rewrite extensionless app routes, not missing .js/.css/.png/.pdf files
RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{2,8}$

RewriteRule ^ /index.html [L]
